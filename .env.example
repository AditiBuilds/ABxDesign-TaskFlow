# Root environment configuration template
# Server settings
PORT=5000
NODE_ENV=development

# Database connection
# Default SQLite for instant zero-dependency local execution:
DATABASE_URL="file:./dev.db"

# Or PostgreSQL (e.g. Supabase / Neon / Render) for cloud deployment:
# DATABASE_URL="postgresql://user:password@host:5432/taskflow_db?schema=public"

# Frontend client URL for CORS
CLIENT_URL="http://localhost:5173"
